# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
# No trailing slash: a bare `node_modules/` matches only directories, which let
# a `node_modules` symlink get committed once and break `npm ci` on checkout.
node_modules

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# test output
coverage/

# local git worktrees
.claude/worktrees/

# local env files
.env*.local

# local household DB when running home-server outside Compose
home-server/data/

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
.env.local
