# Local development only. On Vercel deployments the AI Gateway authenticates
# via OIDC and no key is needed.
AI_GATEWAY_API_KEY=

# Xiaomi MiMo key, from https://mimo.mi.com. Required by the `mimo` adapter in
# every environment — MiMo is called directly, so OIDC does not cover it.
# A real secret: it belongs here and in `vercel env`, never in the app bundle.
MIMO_API_KEY=

# Which registered adapter answers by default. See GET /api/adapters.
RECOGNITION_ADAPTER=mimo

# Provider call budget, kept below the mobile client's own 15s timeout.
RECOGNITION_TIMEOUT_MS=12000
