# Copy to server/.env.local (gitignored) and fill in.
#
# These are real secrets and stay on the server: the app only ever talks to
# /api/recognize, which holds the provider credential (issue #7).

# Xiaomi MiMo API key, required when RECOGNITION_ADAPTER=mimo.
MIMO_API_KEY=

# Which registered adapter answers by default: mimo | claude-haiku |
# claude-sonnet | gemini-flash. Defaults to mimo.
RECOGNITION_ADAPTER=mimo

# Optional shared secret the app must send as x-inventory-key. Unset = open,
# which is fine for local development.
RECOGNITION_SHARED_SECRET=
