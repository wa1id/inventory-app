{
  "name": "inventory-home-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Household inventory API for the home LAN, reached through Cloudflare Tunnel",
  "scripts": {
    "dev": "node --import tsx src/index.ts",
    "start": "node --import tsx src/index.ts",
    "backup:r2": "node --import tsx src/backup-cli.ts",
    "restore:r2": "node --import tsx src/restore-r2.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "hono": "^4.9.8",
    "sharp": "^0.35.3",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/sharp": "^0.31.1",
    "typescript": "^5.9.3"
  }
}
