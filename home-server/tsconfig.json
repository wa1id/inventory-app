{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "paths": { "@/*": ["../src/*"] }
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "../src/core/bytes.ts",
    "../src/core/id.ts",
    "../src/db/migrations.ts",
    "../src/db/nodeDatabase.ts",
    "../src/db/types.ts",
    "../src/db/constants.ts",
    "../src/db/repositories.ts",
    "../src/core/shortCode.ts",
    "../src/core/tokenize.ts",
    "../src/repositories/spaces.ts",
    "../src/repositories/containers.ts",
    "../src/repositories/items.ts",
    "../src/repositories/qr.ts",
    "../src/repositories/search.ts"
  ]
}
