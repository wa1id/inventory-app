# Copy to .env.local and fill in. Never commit a real .env file.
#
# Everything prefixed EXPO_PUBLIC_ is inlined into the app bundle at build time
# and must be treated as PUBLIC. Secrets — in particular the AI provider key —
# belong on the recognition backend, never here.

# Our own recognition endpoint (see server/). Leave empty to run with photo
# suggestions off; the app falls back to manual entry cleanly.
#
# Locally: run the host and forward the port to the device, then point this at
# it. The provider key lives in server/.env.local and never reaches the app.
#
#   (cd server && npm install && node --import tsx dev-server.mjs)
#   adb reverse tcp:8787 tcp:8787
#   EXPO_PUBLIC_RECOGNITION_URL=http://localhost:8787/api/recognize
EXPO_PUBLIC_RECOGNITION_URL=

# Shared key the recognition service expects. NOT a secret: EXPO_PUBLIC_ values
# are inlined into the app bundle and can be extracted from a build. It deters
# casual abuse; the server's rate limit is the actual spend cap.
EXPO_PUBLIC_RECOGNITION_KEY=

# Milliseconds before a recognition request is abandoned.
EXPO_PUBLIC_RECOGNITION_TIMEOUT_MS=15000

# Photo and backup service (see worker/). Leave empty to build an app that never
# uploads anything — the backup screen says so, and everything else works
# identically. Must be https in any build you ship: the recovery code travels on
# this connection as a bearer token.
#
# Locally:
#   (cd worker && npm install && npm run dev)
#   adb reverse tcp:8787 tcp:8787
#   EXPO_PUBLIC_SYNC_URL=http://localhost:8787
EXPO_PUBLIC_SYNC_URL=

# Shared key the sync service expects, matching SYNC_SHARED_SECRET on the
# Worker. Same caveat as the recognition key: inlined into the bundle and
# extractable, so it deters discovery rather than protecting an account. What
# protects an account is the recovery code, which is generated on the device.
EXPO_PUBLIC_SYNC_KEY=

# Milliseconds before a sync request is abandoned. Longer than recognition's:
# a backup is megabytes, and nothing is waiting on it.
EXPO_PUBLIC_SYNC_TIMEOUT_MS=60000

# development | preview | production
EXPO_PUBLIC_ENV=development
