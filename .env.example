# Copy to .env.local and fill in. Never commit a real .env file.
#
# Everything prefixed EXPO_PUBLIC_ is inlined into the app bundle at build time
# and must be treated as PUBLIC. Secrets — in particular the AI provider key —
# belong on the recognition backend, never here.

# Our own recognition endpoint. Leave empty to run with photo suggestions off;
# the app falls back to manual entry cleanly.
EXPO_PUBLIC_RECOGNITION_URL=

# Milliseconds before a recognition request is abandoned.
EXPO_PUBLIC_RECOGNITION_TIMEOUT_MS=15000

# development | preview | production
EXPO_PUBLIC_ENV=development
