<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Inventory</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>inventory</string>
				<string>com.wystudio.inventory</string>
			</array>
		</dict>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Inventory uses the camera so you can photograph items you are adding and scan QR labels on your containers.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Inventory can import a photo from your library to illustrate an item you are adding.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIApplicationShortcutItems</key>
	<array>
		<!-- Quick Snap (DECISIONS U5): the title is strings.tabs.quickSnapAction; the type is AppQuickAction.quickSnap. -->
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>com.wystudio.inventory.quickSnap</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Quick Snap</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>camera</string>
		</dict>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>INVAppEnvironment</key>
	<string>$(INV_APP_ENV)</string>
	<key>INVRecognitionURL</key>
	<string>$(INV_RECOGNITION_URL)</string>
	<key>INVRecognitionKey</key>
	<string>$(INV_RECOGNITION_KEY)</string>
	<key>INVRecognitionTimeoutMs</key>
	<string>$(INV_RECOGNITION_TIMEOUT_MS)</string>
	<key>INVSyncURL</key>
	<string>$(INV_SYNC_URL)</string>
	<key>INVSyncKey</key>
	<string>$(INV_SYNC_KEY)</string>
	<key>INVSyncTimeoutMs</key>
	<string>$(INV_SYNC_TIMEOUT_MS)</string>
	<key>INVHouseholdOrigin</key>
	<string>$(INV_HOUSEHOLD_ORIGIN)</string>
</dict>
</plist>
