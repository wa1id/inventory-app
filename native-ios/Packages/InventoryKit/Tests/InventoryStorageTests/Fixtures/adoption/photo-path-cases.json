    "Documents/item-photos/3f1c2a9e-8b7d-4c1e-9f00-1a2b3c4d5e6f.webp",
    "Documents/item-photos/3f1c2a9e-8b7d-4c1e-9f00-1a2b3c4d5e6f-thumb.webp",
    "Documents/item-photos/9b2e4c71-0d3a-4f8e-b5c6-7a1d2e3f4a5b.jpg",
    "Documents/item-photos/photo-row-7.webp",
    "Documents/item-photos/My Photo.webp",
    "Library/Caches/household-photos/a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d.webp",
    "Library/Caches/household-photos/a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d-thumb.webp",
    "Documents/elsewhere/loose.webp"
  ],
  "cases": [
