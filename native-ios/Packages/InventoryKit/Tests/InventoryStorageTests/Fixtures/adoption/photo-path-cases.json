      "stored": "file:///Users/someone/Library/Developer/CoreSimulator/Devices/5C1D2E3F-0A1B-4C2D-8E3F-4A5B6C7D8E9F/data/Containers/Data/Application/1A2B3C4D-5E6F-4A7B-8C9D-0E1F2A3B4C5D/Documents/item-photos/My%20Photo.webp",
      "expected": "Documents/item-photos/My Photo.webp"
    },
    {
      "name": "a file outside the photo directories is not rebased",
      "stored": "file:///var/mobile/Containers/Data/Application/0E7C3B5A-1F2D-4E6A-9B8C-7D6E5F4A3B2C/Documents/elsewhere/loose.webp",
      "expected": null
