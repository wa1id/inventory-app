      "expected": "Documents/item-photos/3f1c2a9e-8b7d-4c1e-9f00-1a2b3c4d5e6f.webp"
    },
    {
      "name": "stale container UUID, thumbnail",
      "stored": "file:///var/mobile/Containers/Data/Application/0E7C3B5A-1F2D-4E6A-9B8C-7D6E5F4A3B2C/Documents/item-photos/3f1c2a9e-8b7d-4c1e-9f00-1a2b3c4d5e6f-thumb.webp",
      "expected": "Documents/item-photos/3f1c2a9e-8b7d-4c1e-9f00-1a2b3c4d5e6f-thumb.webp"
    },
    {
      "name": "stale container UUID, MVP-era jpg (shape 2)",
      "stored": "file:///var/mobile/Containers/Data/Application/0E7C3B5A-1F2D-4E6A-9B8C-7D6E5F4A3B2C/Documents/item-photos/9b2e4c71-0d3a-4f8e-b5c6-7a1d2e3f4a5b.jpg",
      "expected": "Documents/item-photos/9b2e4c71-0d3a-4f8e-b5c6-7a1d2e3f4a5b.jpg"
    },
    {
      "name": "stale container UUID, file gone",
      "stored": "file:///var/mobile/Containers/Data/Application/0E7C3B5A-1F2D-4E6A-9B8C-7D6E5F4A3B2C/Documents/item-photos/00000000-0000-4000-8000-000000000000.webp",
      "expected": null
    },
    {
      "name": "stale container UUID, household photo cache",
      "stored": "file:///var/mobile/Containers/Data/Application/0E7C3B5A-1F2D-4E6A-9B8C-7D6E5F4A3B2C/Library/Caches/household-photos/a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d-thumb.webp",
      "expected": "Library/Caches/household-photos/a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d-thumb.webp"
