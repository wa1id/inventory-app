    {
      "name": "household shadow row (shape 3)",
      "stored": "r2:household/primary/photos/a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d.webp",
      "expected": null
    },
    {
      "name": "http URI",
      "stored": "https://inventory.wystudio.be/v1/photos/a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d",
