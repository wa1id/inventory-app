    "privacy.backupAccount" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is no account, no email address and no password. The app generates a recovery code on this phone and stores your backup under a name derived from it. That code is the only way to reach the backup, including for us. It is not recoverable, and if you lose it the backup cannot be opened by anyone, including you."
          }
        }
      }
    },
    "privacy.backupLocal" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turning backup on does not change what is on this phone. Deleting an item deletes the stored copy of its photo too."
          }
        }
      }
    },
    "privacy.backupOff" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backup is off unless you turn it on. If you do, a copy of that database and your photos is uploaded so you can get them back after losing or replacing this phone. If you leave it off, nothing is uploaded and uninstalling the app deletes everything."
          }
        }
      }
    },
    "privacy.backupOffPaired" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backup is off unless you turn it on. If you do, a copy of this phone’s database and photos is uploaded so you can get them back after losing or replacing this phone. If you leave it off, uninstalling the app deletes this phone’s copy; the household’s inventory stays on the home server."
          }
        }
      }
    },
    "privacy.backupPassword" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anyone who has the code can read that inventory, so it is worth treating like a password. Uploads travel over an encrypted connection. Your five most recent database snapshots are kept, so a mistake you notice later can still be undone."
          }
        }
      }
    },
    "privacy.backupTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you turn on backup"
          }
        }
      }
    },
    "privacy.cameraTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camera and photos"
          }
        }
      }
    },
    "privacy.cameraUse" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The camera is used for two things: photographing an item you are adding, and scanning a QR label."
          }
        }
      }
    },
    "privacy.diagnosticsBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diagnostic events record only timings and outcome categories: how long something took and whether it succeeded. Item names, notes, photos, search text and QR codes are filtered out before anything is recorded, and no crash or analytics provider is enabled in this build."
          }
        }
      }
    },
    "privacy.diagnosticsTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diagnostics"
          }
        }
      }
    },
    "privacy.householdBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The inventory lives on your household’s home server, and this phone keeps a copy of what it reads and writes. Photos are stored in the household’s private storage, so every phone in the household can see them. Changes need an internet connection, even at home. Other phones in the household can see everything you add."
          }
        }
      }
    },
    "privacy.householdTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When this phone is part of a household"
          }
        }
      }
    },
    "privacy.noBackupService" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backup is not set up in this build, so nothing is uploaded anywhere. Uninstalling the app deletes all of it."
          }
        }
      }
    },
    "privacy.noBackupServicePaired" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backup is not set up in this build, so this phone’s copy is not uploaded anywhere else. Uninstalling the app deletes that copy."
          }
        }
      }
    },
    "privacy.offlineBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything except photo suggestions and backup works with no network connection at all, including adding items, scanning labels and searching. Backups wait for a connection and catch up on their own; nothing you do is blocked while they wait."
          }
        }
      }
    },
    "privacy.offlinePaired" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Searching and browsing what this phone last loaded can work without the internet. Adding and changing things needs it."
          }
        }
      }
    },
    "privacy.offlineTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Working offline"
          }
        }
      }
    },
    "privacy.photosDeleted" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleting an item, its container or its space also deletes the photo file from this phone."
          }
        }
      }
    },
    "privacy.photosLocal" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photos you take in the app are saved to the app’s own private storage, not to your camera roll."
          }
        }
      }
    },
    "privacy.photosPaired" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photos you take in the app are saved to the app’s own private storage and, while this phone is part of a household, to the household’s private storage. They are not saved to your camera roll."
          }
        }
      }
    },
    "privacy.photosResized" : {
      "comment" : "Arguments: maxDimension (count).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importing a photo copies it; the original is left untouched. Each photo is resized to at most %lld pixels on its long edge and re-encoded as a WebP image before it is saved, alongside a small thumbnail used in lists."
          }
        }
      }
    },
    "privacy.suggestionsOff" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo suggestions are not configured in this build, so no image is ever sent for suggestions. Items are always added by typing the details."
          }
        }
      }
    },
    "privacy.suggestionsPrivate" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Images are sent for that one request and are not used to build a profile of you. Your notes and other item details are never sent."
          }
        }
      }
    },
    "privacy.suggestionsSent" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you add an item with a photo, that single image is sent to our service to suggest a name, category and tags. The suggestion is only a suggestion: you can edit or ignore it, and saving an item never requires it."
          }
        }
      }
    },
    "privacy.suggestionsTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo suggestions"
          }
        }
      }
    },
    "privacy.title" : {
      "comment" : "Header title, read by the root layout.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privacy and your data"
          }
        }
      }
    },
    "privacy.whereBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
